# Stage Coach Environment Configuration
# Copy this file to .env and fill in your values

# Generate local values; never commit the populated .env file.
POSTGRES_PASSWORD=
AUTH_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
PRIVATE_BETA_EMAIL=

# Auth / web
NEXTAUTH_URL=http://localhost:3000
PRIVATE_BETA_MODE=true
STAGECOACH_PORT=3107
ASR_MODEL=tiny
MAX_UPLOAD_BYTES=83886080

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature Flags
ENABLE_EXPRESSION_ANALYSIS=false
