# Stage Coach Environment Configuration
# Copy this file to .env and fill in your values

# Generate local values; never commit the populated .env file.
POSTGRES_PASSWORD=
AUTH_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
PRIVATE_BETA_EMAIL=

# Auth / web
NEXTAUTH_URL=http://localhost:3000
PRIVATE_BETA_MODE=true
STAGECOACH_PORT=3107
ASR_MODEL=tiny
MAX_UPLOAD_BYTES=83886080

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature Flags
ENABLE_EXPRESSION_ANALYSIS=false

# D9 identity. Leave Apple unset to keep Sign in with Apple disabled.
# EMAIL_PROVIDER=console
# D10 Resend. Leave unset to keep the console email stand-in.
# RESEND_API_KEY=
# STAGECOACH_EMAIL_FROM=Stage Coach <noreply@cybersphere.com.br>
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Default LLM is local OpenAI-compatible (LM Studio on TIGER, qwen/qwen3.8-27b).
# No API key. Point this at TIGER when the app is not on the same host.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_PROVIDER=local

# Optional. xAI/Grok is selectable in Settings but off by default.
# The app boots and deploys without this key.
# XAI_API_KEY=

# AES-256-GCM key for pose/face parquet (64 hex chars). Generate locally; never commit.
# openssl rand -hex 32
STAGECOACH_ARTIFACT_KEY=
