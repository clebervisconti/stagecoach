# Stage Coach Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://stagecoach:dev_password_change_in_prod@postgres:5432/stagecoach

# Redis
REDIS_URL=redis://redis:6379

# Object Storage (MinIO/S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Auth (NextAuth/Auth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# LLM Provider (to be configured in Phase 1+)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Observability (optional)
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature Flags
# ENABLE_EXPRESSION_ANALYSIS=false
